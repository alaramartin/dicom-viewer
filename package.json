{
  "name": "dicom-viewer",
  "displayName": "DICOM Viewer & Editor",
  "description": "View DICOM images and edit metadata side-by-side, right in your VS Code editor.",
  "version": "1.4.0",
  "publisher": "alarm",
  "icon": "media/images/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/alaramartin/dicom-viewer.git"
  },
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "vscode",
    "extension",
    "dcm",
    "dicom",
    "viewer",
    "editor",
    "metadata",
    "medical",
    "radiology",
    "pacs",
    "imaging"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "dicomViewer.dcm",
        "displayName": "DICOM Viewer",
        "selector": [
          {
            "filenamePattern": "*.dcm"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node build/esbuild.mjs",
    "package": "npm run check-types && npm run lint && node build/esbuild.mjs --production",
    "watch": "node build/esbuild.mjs --watch",
    "watch:tsc": "tsc --noEmit --watch -p ./",
    "check-types": "tsc --noEmit -p ./",
    "compile-tests": "tsc -p ./ --outDir out",
    "watch-tests": "tsc -p ./ -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.103.0",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.32.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@iwharris/dicom-data-dictionary": "^1.26.0",
    "dcmjs": "^0.45.0",
    "dicom-parser": "^1.8.21",
    "pngjs": "^7.0.0"
  }
}
