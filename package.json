{
  "name": "dicom-viewer",
  "displayName": "DICOM Viewer & Editor",
  "description": "View DICOM images and edit metadata side-by-side, right in your VS Code editor.",
  "version": "1.7.0",
  "publisher": "alarm",
  "icon": "media/images/logo.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alaramartin/dicom-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/alaramartin/dicom-viewer/issues"
  },
  "homepage": "https://github.com/alaramartin/dicom-viewer",
  "qna": "https://github.com/alaramartin/dicom-viewer/issues",
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "vscode",
    "extension",
    "dcm",
    "dicom",
    "viewer",
    "editor",
    "metadata",
    "medical",
    "radiology",
    "pacs",
    "imaging"
  ],
  "galleryBanner": {
    "color": "#1A1A2E",
    "theme": "dark"
  },
  "badges": [
    {
      "url": "https://img.shields.io/visual-studio-marketplace/v/alarm.dicom-viewer",
      "href": "https://marketplace.visualstudio.com/items?itemName=alarm.dicom-viewer",
      "description": "Visual Studio Marketplace Version"
    },
    {
      "url": "https://img.shields.io/visual-studio-marketplace/i/alarm.dicom-viewer",
      "href": "https://marketplace.visualstudio.com/items?itemName=alarm.dicom-viewer",
      "description": "Visual Studio Marketplace Installs"
    },
    {
      "url": "https://img.shields.io/visual-studio-marketplace/r/alarm.dicom-viewer",
      "href": "https://marketplace.visualstudio.com/items?itemName=alarm.dicom-viewer",
      "description": "Visual Studio Marketplace Rating"
    },
    {
      "url": "https://img.shields.io/github/license/alaramartin/dicom-viewer",
      "href": "https://github.com/alaramartin/dicom-viewer/blob/main/LICENSE.md",
      "description": "License: MIT"
    }
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "dicomViewer.dcm",
        "displayName": "DICOM Viewer",
        "selector": [
          {
            "filenamePattern": "*.dcm"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "dicomViewer.openDicom",
        "title": "Open DICOM…",
        "category": "DICOM"
      },
      {
        "command": "dicomViewer.exportMetadata",
        "title": "Export Metadata…",
        "category": "DICOM"
      },
      {
        "command": "dicomViewer.resetWindowLevel",
        "title": "Reset Window/Level",
        "category": "DICOM"
      },
      {
        "command": "dicomViewer.toggleMetadataPanel",
        "title": "Toggle Metadata Panel",
        "category": "DICOM"
      },
      {
        "command": "dicomViewer.sendFeedback",
        "title": "Send Feedback",
        "category": "DICOM"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "dicomViewer.exportMetadata",
          "when": "activeCustomEditorId == dicomViewer.dcm"
        },
        {
          "command": "dicomViewer.resetWindowLevel",
          "when": "activeCustomEditorId == dicomViewer.dcm"
        },
        {
          "command": "dicomViewer.toggleMetadataPanel",
          "when": "activeCustomEditorId == dicomViewer.dcm"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node build/esbuild.mjs",
    "package": "npm run check-types && npm run lint && node build/esbuild.mjs --production",
    "watch": "node build/esbuild.mjs --watch",
    "watch:tsc": "tsc --noEmit --watch -p ./",
    "check-types": "tsc --noEmit -p ./",
    "compile-tests": "tsc -p ./ --outDir out",
    "watch-tests": "tsc -p ./ -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.103.0",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.32.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@cornerstonejs/codec-charls": "^1.2.5",
    "@cornerstonejs/codec-openjpeg": "^1.3.2",
    "@iwharris/dicom-data-dictionary": "^1.26.0",
    "dcmjs": "^0.45.0",
    "dicom-parser": "^1.8.21",
    "jpeg-js": "^0.4.4",
    "jpeg-lossless-decoder-js": "^2.1.2",
    "pngjs": "^7.0.0"
  }
}
